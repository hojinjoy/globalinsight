# Claude (LLM), used only by globalinsight/synthesize.py. Get one at
# https://console.anthropic.com. Alternatively run `ant auth login` and leave
# this unset. Not required for the rest of the package (quote, filings,
# financials, and the CLI all work without it).
ANTHROPIC_API_KEY=

# SEC EDGAR requires a User-Agent naming a real contact address, and rejects
# generic browser strings (and anything with no contact info) with a 403 -
# sometimes at the IP level. Defaults to "GlobalInsight Research
# your-email@example.com" if unset - override for your own deployment.
SEC_USER_AGENT=Your Name your.address@your-domain.com
